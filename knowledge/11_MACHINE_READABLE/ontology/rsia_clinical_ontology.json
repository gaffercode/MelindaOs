  "emergency_red_flags": {
    "maternal_triggers": [
      "perdarahan jalan lahir aktif pada kehamilan",
      "nyeri perut hebat mendadak pada trimester 3",
      "tekanan darah >= 160/110 mmHg",
      "sakit kepala hebat dengan pandangan kabur / scotoma",
      "nyeri ulu hati hebat (epigastric pain) pada bumil",
      "gerakan janin berkurang drastis atau tidak terasa",
      "keluar cairan ketuban hijau/keruh atau berbau sebelum inpartu",
      "kejang pada ibu hamil atau pasca persalinan"
    ],
    "pediatric_triggers": [
      "bayi sesak napas, merintih (grunting), retraksi dada berat",
      "bayi biru (sianosis) pada bibir atau ekstremitas",
      "bayi tidak mau menyusu sama sekali / letargis / lemas terkulai",
      "kejang pada bayi atau anak",
      "demam tinggi pada neonatus usia < 28 hari",
      "muntah hijau atau perut kembung tegang hebat",
      "tanda dehidrasi berat: mata sangat cekung, ubun-ubun cekung, turgor lambat"
    ],
    "mandatory_action": {
      "response_type": "IMMEDIATE_IGD_ROUTING",
      "message": "Segera bawa pasien ke Instalasi Gawat Darurat (IGD) 24 Jam RSIA Melinda DHAI. Kondisi ini memerlukan pemeriksaan dokter secara langsung dan cepat. Jangan menunggu jadwal poli!",
      "hotline": "IGD RSIA Melinda 24 Jam"
    }
