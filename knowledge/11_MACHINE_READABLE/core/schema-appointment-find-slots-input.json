{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appointment.find_slots input",
  "description": "Input for appointment.find_slots: find bookable slots for a doctor or a service. Risk R1. Requires doctor_id or service_id.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "doctor_id": {
      "type": "string",
      "minLength": 1,
      "description": "Doctor identifier from doctor.search."
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "description": "Service identifier from service.search."
    },
    "date_from": {
      "type": "string",
      "format": "date",
      "description": "First date of the search range (ISO 8601 date)."
    },
    "date_to": {
      "type": "string",
      "format": "date",
      "description": "Last date of the search range (ISO 8601 date)."
    },
    "time_preference": {
      "type": "string",
      "enum": [
        "any",
        "morning",
        "afternoon",
        "evening"
      ],
      "description": "Optional preferred part of the day."
    },
    "location_id": {
      "type": "string",
      "description": "Optional hospital location identifier."
    },
    "payer_type": {
      "type": "string",
      "description": "Optional payer type for the requested visit."
    }
  },
  "required": [
    "date_from",
    "date_to"
  ],
  "anyOf": [
    {
      "required": [
        "doctor_id"
      ]
    },
    {
      "required": [
        "service_id"
      ]
    }
  ],
  "governance": {
    "status": "APPROVED",
    "validation_level": "CANONICAL",
    "validated_by": "dr. Ferdi Andriska, S.H., M.Kn., CMDC",
    "role": "Director in Command",
    "date_enacted": "2026-09-28",
    "enforcement": "Strict / Mandatory"
  }
}
