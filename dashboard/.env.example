# Server-only. Never prefix these variables with NEXT_PUBLIC_.
MELINDAOS_DIRECTOR_STORE=supabase
MELINDAOS_APP_ORIGIN=https://your-dashboard-domain.example
MELINDAOS_SUPABASE_URL=https://your-project-ref.supabase.co
MELINDAOS_SUPABASE_SECRET_KEY=
MELINDAOS_REVIEWER_ID=director
MELINDAOS_REVIEWER_PASSCODE_HASH=
# Escape $ as \$ in .env.local because Next.js dotenv-expand expands bare $.
# Claude API key for Melinda (model claude-sonnet-5-5), the "Polish" note button and the "Arahan" draft panel.
# Notes with patient identifiers are blocked before any call. Server-only; never expose to the browser.
# ANTHROPIC_API_KEY is still accepted when this one is empty.
MELINDAOS_CLAUDE_API_KEY=
# Optional. Read only when MELINDAOS_CLAUDE_API_KEY is empty (lib/claude-client.ts).
# ANTHROPIC_API_KEY=
# Optional model overrides for Melinda chat and for "Tanya Melinda"; empty uses the built-in defaults.
MELINDAOS_MELINDA_MODEL=
MELINDAOS_ASK_MODEL=
# Optional model override for the automatic management brief; empty uses claude-opus-5-5.
MELINDAOS_BRIEF_MODEL=
# Optional. Medify publisher on Biznet: SHA-256 of its token. Producer id defaults to "biznet-medify".
MELINDAOS_MEDIFY_PUBLISHER_TOKEN_HASH=
MELINDAOS_MEDIFY_PUBLISHER_ID=
# Optional. SATUSEHAT OAuth2 API credentials for on-demand Director sync (/satu-sehat) and Biznet puller.
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=
SATUSEHAT_ENV=production
MELINDAOS_SATUSEHAT_PUBLISHER_TOKEN_HASH=
MELINDAOS_SATUSEHAT_PUBLISHER_ID=
# Optional SATUSEHAT overrides. Empty keeps the built-in value for SATUSEHAT_ENV and this hospital.
# SATUSEHAT_AUTH_BASE_URL=
# SATUSEHAT_FHIR_BASE_URL=
# SATUSEHAT_FACILITY_CODE=
# SATUSEHAT_FACILITY_NAME=
# SATUSEHAT_CONCURRENCY=
# Optional. Folder for the lock file of scripts/run-satusehat-scheduled.mjs; empty uses the system temp folder.
# MELINDAOS_SATUSEHAT_LOCK_DIR=
# Vercel Cron (vercel.json, 05:55 and 17:55 WIB) calls /api/cron/satusehat with "Authorization: Bearer <CRON_SECRET>".
# At least 16 characters; empty disables the cron route (fail closed).
CRON_SECRET=
# Optional. Reception WhatsApp for the public referral sheet (/rujukan), digits only. Empty hides the button.
MELINDAOS_REFERRAL_WHATSAPP=
# Optional. STARKES evidence from Google Drive: service-account JSON and the root folder id that holds the chapter folders.
MELINDAOS_GOOGLE_SA_JSON=
MELINDAOS_STARKES_DRIVE_ROOT=
# Buffer GraphQL API key from Settings ? API. Server-only; never NEXT_PUBLIC_.
BUFFER_API_KEY=
# Optional when the Buffer account has more than one organization.
BUFFER_ORGANIZATION_ID=
# Leave disabled on hosted systems; loopback-only development is the exception.
MELINDAOS_ALLOW_LOCAL_HTTP=0

# Optional dedicated synthetic database for explicit integration verification.
MELINDAOS_TEST_SUPABASE_URL=
MELINDAOS_TEST_SUPABASE_SECRET_KEY=
MELINDAOS_RUN_DATABASE_TESTS=0

# Build only. "required" makes scripts/fetch-private-data.mjs download the private data before the build and
# fail when it cannot. Any other value skips the download; a local build then uses the files on disk.
# MELINDAOS_PRIVATE_DATA=

# Optional local paths. MELINDAOS_ROOT defaults to the parent of dashboard/.
MELINDAOS_ROOT=
# Local file-mode daily reports; defaults to dashboard/data/director.
MELINDAOS_DIRECTOR_DATA_DIR=

# Server-only JSON array of verified signed archive records. See docs/guides/studio-publication.md.
MELINDAOS_STUDIO_SIGNATURE_REGISTER=[]
# Optional path to the Studio source snapshot; defaults to dashboard/data/studio-source-snapshot.json.
MELINDAOS_STUDIO_SNAPSHOT=
# Local file-mode daily reports. Defaults: dashboard/data/melinda, data/simrs, data/puskesmas, data/news,
# data/medify, data/medify-run-status.
MELINDAOS_MELINDA_BRIEF_DIR=
MELINDAOS_SIMRS_DIR=
MELINDAOS_PUSKESMAS_BRIEF_DIR=
MELINDAOS_NEWS_EDITION_DIR=
MELINDAOS_MEDIFY_DIR=
MELINDAOS_MEDIFY_RUN_STATUS_DIR=
MELINDAOS_SATUSEHAT_DIR=

# Used only by the Medify publisher (scripts/medify-pull.mjs on the Biznet server), never by the app server.
MELINDAOS_DASHBOARD_URL=
MELINDAOS_PUBLISHER_TOKEN=
# Medify reporting-only account for scripts/medify-pull.mjs. Set it on the scheduler host only, never on the app
# server and never in a tracked file.
# MEDIFY_EMAIL=
# MEDIFY_PASSWORD=
# Optional Medify puller overrides (scripts/medify-pull.mjs). Empty keeps the script's own defaults.
# MEDIFY_BASE_URL=
# MEDIFY_CONCURRENCY=
# Optional. Folder that receives raw Medify responses for diagnosis; the scheduled run ignores it.
# MEDIFY_DUMP_RAW_DIR=
# Optional. Folder for the lock file of scripts/run-medify-scheduled.mjs; empty uses the system temp folder.
# MELINDAOS_MEDIFY_LOCK_DIR=

# All-Access Agent MCP (/api/mcp). Preferred: one token per bot, stored on the server as SHA-256 hex only:
#   MELINDAOS_MCP_TOKEN_HASHES=katt=<sha256hex>,openbot=<sha256hex>,laptop=<sha256hex>
# Names: a-z, 0-9 and -, up to 32 characters; "shared", "director" and "local" are reserved.
# Any malformed entry rejects every token with 503 (fail closed). Legacy single token, still accepted as
# credential "shared": set either the raw token or its SHA-256 hex hash.
MELINDAOS_MCP_TOKEN_HASHES=
MELINDAOS_MCP_TOKEN=
MELINDAOS_MCP_TOKEN_HASH=
