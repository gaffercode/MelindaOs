{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SATUSEHAT snapshot v1",
  "description": "Aggregate resource counts pulled from the Kemenkes SATUSEHAT OAuth2 FHIR API (using _summary=count only, never patient records) or verified portal export. No patient identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "date",
    "environment",
    "organizationId",
    "facilityCode",
    "facilityName",
    "observedAt",
    "periodStart",
    "periodEnd",
    "periodLabel",
    "source",
    "logSummary",
    "resources",
    "unavailableResources",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "$ref": "#/$defs/date" },
    "environment": { "enum": ["production", "staging"] },
    "organizationId": { "$ref": "#/$defs/text" },
    "facilityCode": { "$ref": "#/$defs/text" },
    "facilityName": { "$ref": "#/$defs/text" },
    "observedAt": { "$ref": "#/$defs/timestamp" },
    "periodStart": { "$ref": "#/$defs/date" },
    "periodEnd": { "$ref": "#/$defs/date" },
    "periodLabel": { "$ref": "#/$defs/text" },
    "source": { "enum": ["oauth2_fhir_api", "portal_export"] },
    "logSummary": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/logSummary" }
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "items": { "$ref": "#/$defs/resourceCount" }
    },
    "unavailableResources": {
      "type": "array",
      "maxItems": 19,
      "items": { "$ref": "#/$defs/text" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 300, "pattern": "\\S" },
    "note": { "type": "string", "maxLength": 2000 },
    "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "maxLength": 5, "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "timestamp": { "type": "string", "maxLength": 40, "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:0\\d|1[0-4]):[0-5]\\d)$" },
    "https": { "type": "string", "maxLength": 500, "pattern": "^https://\\S+$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 100000000 },
    "rate": { "type": "number", "minimum": 0, "maximum": 100 },
    "logSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalTransactions", "successfulTransactions", "failedTransactions", "successRatePercent", "failureRatePercent"],
      "properties": {
        "totalTransactions": { "$ref": "#/$defs/count" },
        "successfulTransactions": { "$ref": "#/$defs/count" },
        "failedTransactions": { "$ref": "#/$defs/count" },
        "successRatePercent": { "$ref": "#/$defs/rate" },
        "failureRatePercent": { "$ref": "#/$defs/rate" }
      }
    },
    "resourceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "status", "periodMode"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "count": { "$ref": "#/$defs/count" },
        "status": { "enum": ["ok", "unavailable"] },
        "periodMode": { "enum": ["rolling_30d", "all_time"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "sourceObservedAt", "periodStart", "periodEnd", "cutoff", "sources", "notes"],
      "properties": {
        "producer": { "$ref": "#/$defs/text" },
        "sourceObservedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "cutoff": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "note"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "url": { "anyOf": [{ "$ref": "#/$defs/https" }, { "type": "null" }] },
              "note": { "$ref": "#/$defs/note" }
            }
          }
        },
        "notes": { "$ref": "#/$defs/note" }
      }
    }
  }
}
