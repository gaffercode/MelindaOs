{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medify snapshot v1",
  "description": "Aggregate counts pulled from Medify (simrs.melinda.co.id) with the Director's reporting account by scripts/medify-pull.mjs. Counts and rupiah totals only, never patient rows. A null section means that pull failed; provenance.notes names it. A null rupiah value means Medify returned something that is not a non-negative amount. Sections added later (inpatientMix, igdMix, diagnostics, pharmacy, staff) are optional so earlier snapshots stay valid; their lists cover Medify's rolling month (periodStart..periodEnd).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "bed", "outpatient", "igd", "inpatient", "finance", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "$ref": "#/$defs/date" },
    "bed": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/bed" }] },
    "outpatient": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/outpatient" }] },
    "igd": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/igd" }] },
    "inpatient": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/inpatient" }] },
    "finance": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/finance" }] },
    "inpatientMix": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/inpatientMix" }] },
    "igdMix": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/igdMix" }] },
    "diagnostics": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/diagnostics" }] },
    "pharmacy": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/pharmacy" }] },
    "staff": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/staff" }] },
    "satusehat": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/satusehat" }] },
    "patients": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/patients" }] },
    "run": { "$ref": "#/$defs/run" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 300, "pattern": "\\S" },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "runId", "status", "startedAt", "completedAt", "unavailableSections"],
      "properties": {
        "slot": { "enum": ["morning", "evening"] },
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$", "maxLength": 80 },
        "status": { "enum": ["complete", "degraded"] },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "unavailableSections": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/runIssue" } }
      }
    },
    "runIssue": {
      "type": "object", "additionalProperties": false, "required": ["section", "reason"],
      "properties": {
        "section": { "enum": ["bed", "outpatient", "igd", "inpatient", "inpatientMix", "igdMix", "diagnostics", "pharmacy", "staff", "finance", "satusehat", "patients"] },
        "reason": { "enum": ["request_failed", "format_changed", "response_too_large", "access_denied", "validation_failed"] }
      }
    },
    "note": { "type": "string", "maxLength": 2000 },
    "date": { "type": "string", "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "maxLength": 5, "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "timestamp": { "type": "string", "maxLength": 40, "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?(?:Z|[+-](?:0\\d|1[0-4]):[0-5]\\d)$" },
    "https": { "type": "string", "maxLength": 500, "pattern": "^https://\\S+$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "nullableCount": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
    "rate": { "type": "number", "minimum": 0, "maximum": 100000 },
    "rupiah": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 1000000000000000 }, { "type": "null" }] },
    "namedCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "visits"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "visits": { "$ref": "#/$defs/count" } }
    },
    "bed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "wards"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "wards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ward", "kelas", "occupied", "capacity"],
            "properties": {
              "ward": { "$ref": "#/$defs/text" },
              "kelas": { "$ref": "#/$defs/text" },
              "occupied": { "$ref": "#/$defs/count" },
              "capacity": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    },
    "outpatient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "periodStart", "periodEnd", "visitsToday", "daily", "byClinic", "newPatients", "returningPatients", "byPayer"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "visitsToday": { "$ref": "#/$defs/nullableCount" },
        "daily": {
          "type": "array",
          "maxItems": 62,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "visits"],
            "properties": { "date": { "$ref": "#/$defs/date" }, "visits": { "$ref": "#/$defs/count" } }
          }
        },
        "byClinic": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/namedCount" } },
        "newPatients": { "$ref": "#/$defs/nullableCount" },
        "returningPatients": { "$ref": "#/$defs/nullableCount" },
        "byPayer": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/namedCount" } }
      }
    },
    "igd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "visitsToday", "daily", "topDiagnoses"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "visitsToday": { "$ref": "#/$defs/nullableCount" },
        "daily": {
          "type": "array",
          "maxItems": 31,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "visits"],
            "properties": { "date": { "$ref": "#/$defs/date" }, "visits": { "$ref": "#/$defs/count" } }
          }
        },
        "topDiagnoses": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedCount" } }
      }
    },
    "inpatient": {
      "description": "Medify's rawat inap dashboard. daily: complete days only (admissions, BOR %). monthly: Medify's own BOR %, TOI days, BTO times, NDR and GDR per mille; the last month is month to date. AVLOS is left out because Medify returns 0 for every month. Daily items may carry Medify's admission channels (online, onsite, anjungan).",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "daily", "monthly"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "daily": {
          "type": "array",
          "minItems": 1,
          "maxItems": 31,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "admissions", "bor"],
            "properties": { "date": { "$ref": "#/$defs/date" }, "admissions": { "$ref": "#/$defs/count" }, "bor": { "$ref": "#/$defs/rate" }, "online": { "$ref": "#/$defs/count" }, "onsite": { "$ref": "#/$defs/count" }, "anjungan": { "$ref": "#/$defs/count" } }
          }
        },
        "monthly": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["month", "admissions", "bor", "toi", "bto", "ndr", "gdr"],
            "properties": {
              "month": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
              "admissions": { "$ref": "#/$defs/count" },
              "bor": { "$ref": "#/$defs/rate" },
              "toi": { "$ref": "#/$defs/rate" },
              "bto": { "$ref": "#/$defs/rate" },
              "ndr": { "$ref": "#/$defs/rate" },
              "gdr": { "$ref": "#/$defs/rate" }
            }
          }
        }
      }
    },
    "finance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "cashToday", "revenueToday", "receivablesTotal", "payablesTotal"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "cashToday": { "$ref": "#/$defs/rupiah" },
        "revenueToday": { "$ref": "#/$defs/rupiah" },
        "receivablesTotal": { "$ref": "#/$defs/rupiah" },
        "payablesTotal": { "$ref": "#/$defs/rupiah" }
      }
    },
    "namedTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "count": { "$ref": "#/$defs/count" } }
    },
    "namedShare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "percent"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "percent": { "$ref": "#/$defs/rate" } }
    },
    "namedRupiah": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rupiah"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "rupiah": { "$ref": "#/$defs/rupiah" } }
    },
    "monthlyTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "count"],
      "properties": { "month": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" }, "count": { "$ref": "#/$defs/count" } }
    },
    "top10": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedTotal" } },
    "inpatientMix": {
      "description": "Medify rawat inap dashboard over the rolling month. byStatus (Baru/Lama) and byGender are percentages as Medify returns them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "periodStart", "periodEnd", "topDiagnoses", "byWard", "byDpjp", "byPayer", "byStatus", "byGender"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "topDiagnoses": { "$ref": "#/$defs/top10" },
        "byWard": { "$ref": "#/$defs/top10" },
        "byDpjp": { "$ref": "#/$defs/top10" },
        "byPayer": { "$ref": "#/$defs/top10" },
        "byStatus": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedShare" } },
        "byGender": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedShare" } }
      }
    },
    "igdMix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "periodStart", "periodEnd", "byDischarge", "byPayer"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "byDischarge": { "$ref": "#/$defs/top10" },
        "byPayer": { "$ref": "#/$defs/top10" }
      }
    },
    "diagnosticUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topTests", "responseTime"],
      "properties": { "topTests": { "$ref": "#/$defs/top10" }, "responseTime": { "$ref": "#/$defs/top10" } }
    },
    "diagnostics": {
      "description": "Top tests per tariff and Medify's response-time groups; the group labels are Medify's own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "periodStart", "periodEnd", "labPk", "labPa", "radiology"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "labPk": { "$ref": "#/$defs/diagnosticUnit" },
        "labPa": { "$ref": "#/$defs/diagnosticUnit" },
        "radiology": { "$ref": "#/$defs/diagnosticUnit" }
      }
    },
    "pharmacy": {
      "description": "Medify persediaan farmasi: stock value per depot, top items by value and quantity, item counts per drug category.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "periodStart", "periodEnd", "stockByUnit", "topByValue", "topByQuantity", "byCategory"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "stockByUnit": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedRupiah" } },
        "topByValue": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedRupiah" } },
        "topByQuantity": { "$ref": "#/$defs/top10" },
        "byCategory": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/namedTotal" } }
      }
    },
    "staff": {
      "description": "Medify kepegawaian statistik: staff per type and status, and Medify's monthly active and leaving counts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "byType", "byStatus", "activeMonthly", "leftMonthly"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "byType": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/namedTotal" } },
        "byStatus": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/namedTotal" } },
        "activeMonthly": { "type": "array", "maxItems": 13, "items": { "$ref": "#/$defs/monthlyTotal" } },
        "leftMonthly": { "type": "array", "maxItems": 13, "items": { "$ref": "#/$defs/monthlyTotal" } }
      }
    },
    "satusehat": {
      "description": "Medify's SATUSEHAT dashboard summary for the calendar month to date (by discharge date): global percentage sent and, per FHIR resource in FHIR order, expected, sent, failed and not yet sent. Medify's unprocessed count is left out because it can be negative.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "periodStart", "periodEnd", "globalPercent", "expected", "sent", "failed", "notSent", "lastUpdate", "resources"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "globalPercent": { "$ref": "#/$defs/rate" },
        "expected": { "$ref": "#/$defs/count" },
        "sent": { "$ref": "#/$defs/count" },
        "failed": { "$ref": "#/$defs/count" },
        "notSent": { "$ref": "#/$defs/count" },
        "lastUpdate": { "$ref": "#/$defs/text" },
        "resources": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expected", "sent", "failed", "notSent"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "expected": { "$ref": "#/$defs/count" },
              "sent": { "$ref": "#/$defs/count" },
              "failed": { "$ref": "#/$defs/count" },
              "notSent": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    },
    "patients": {
      "description": "Medify pasien statistik: the cumulative patient base and Medify's per-payer tallies over that base (BPJS, Tunai, Asuransi; not a partition of the total, one patient can count under several payers), today's new patients and transactions, monthly visits per service line and monthly new patients for the months up to the report date (the last month is month to date).",
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "total", "newToday", "transactionsToday", "byPayer", "monthlyVisits", "newMonthly"],
      "properties": {
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "total": { "$ref": "#/$defs/count" },
        "newToday": { "$ref": "#/$defs/count" },
        "transactionsToday": { "$ref": "#/$defs/count" },
        "byPayer": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/namedTotal" } },
        "monthlyVisits": {
          "type": "array",
          "maxItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["month", "outpatient", "inpatient", "igd"],
            "properties": {
              "month": { "type": "string", "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
              "outpatient": { "$ref": "#/$defs/count" },
              "inpatient": { "$ref": "#/$defs/count" },
              "igd": { "$ref": "#/$defs/count" }
            }
          }
        },
        "newMonthly": { "type": "array", "maxItems": 13, "items": { "$ref": "#/$defs/monthlyTotal" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "sourceObservedAt", "periodStart", "periodEnd", "cutoff", "sources", "notes"],
      "properties": {
        "producer": { "$ref": "#/$defs/text" },
        "sourceObservedAt": { "$ref": "#/$defs/timestamp" },
        "periodStart": { "$ref": "#/$defs/date" },
        "periodEnd": { "$ref": "#/$defs/date" },
        "cutoff": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "note"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "url": { "anyOf": [{ "$ref": "#/$defs/https" }, { "type": "null" }] },
              "note": { "$ref": "#/$defs/note" }
            }
          }
        },
        "notes": { "$ref": "#/$defs/note" }
      }
    }
  }
}
