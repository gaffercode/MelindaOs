{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medify scheduled run status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "slot", "runId", "status", "startedAt", "completedAt", "unavailableSections", "snapshotRevisionId", "snapshotReceivedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
    "slot": { "enum": ["morning", "evening"] },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$", "maxLength": 80 },
    "status": { "enum": ["complete", "degraded", "failed"] },
    "startedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T", "maxLength": 40 },
    "completedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T", "maxLength": 40 },
    "unavailableSections": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/issue" } },
    "snapshotRevisionId": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$", "maxLength": 36 }] },
    "snapshotReceivedAt": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T", "maxLength": 40 }] }
  },
  "$defs": {
    "issue": { "type": "object", "additionalProperties": false, "required": ["section", "reason"], "properties": { "section": { "anyOf": [{ "type": "null" }, { "enum": ["bed", "outpatient", "igd", "inpatient", "inpatientMix", "igdMix", "diagnostics", "pharmacy", "staff", "finance", "satusehat", "patients"] }] }, "reason": { "enum": ["login_failed", "request_failed", "format_changed", "response_too_large", "access_denied", "validation_failed", "overlap_denied"] } } }
  }
}
