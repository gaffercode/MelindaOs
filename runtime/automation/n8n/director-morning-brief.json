{
  "name": "MAAF - Director Morning Brief Data Assembly",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Daily 06:45",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "45 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "brief",
      "name": "Assemble Executive Exceptions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.MAAF_BACKEND_URL + \"/v1/executive/brief/assemble\"}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"window\":\"since_last_brief\",\"timezone\":\"Asia/Jakarta\"}"
      }
    }
  ],
  "connections": {
    "Daily 06:45": {
      "main": [
        [
          {
            "node": "Assemble Executive Exceptions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  }
}