# Non-secret deployment metadata only.
MAAF_BACKEND_URL=https://maaf.example.melinda.co.id
MAAF_ACTOR_ROLE=ALL_ACCESS
# Inbound MCP authentication is separate from the backend credential.
MAAF_MCP_BEARER_FILE=/run/secrets/maaf_mcp_bearer
# Exact per-endpoint tool names; empty means no tool is enabled.
MAAF_TOOL_ALLOWLIST=
MAAF_GATEWAY_BEARER_FILE=/run/secrets/maaf_gateway_bearer
MAAF_REQUEST_TIMEOUT_SECONDS=20
# Server-side preapproval list; never expose this as a model-controlled parameter.
MAAF_PREAPPROVED_L3=melinda.social.publish,melinda.social.schedule

# All-Access Agent MCP settings
MAAF_ALL_ACCESS=1
MELINDAOS_MCP_TOKEN=
MELINDAOS_MCP_TOKEN_HASH=
MELINDAOS_DASHBOARD_URL=http://127.0.0.1:3000

# Agent MCP server (src/melinda_agent_mcp). MELINDAOS_ROOT defaults to the repository root; the transport defaults to stdio.
# MELINDAOS_ROOT=
# MELINDA_AGENT_MCP_TRANSPORT=stdio

# SATUSEHAT FHIR connector (src/melinda_maaf/connectors/satusehat_fhir.py). The two URLs default to the national
# production endpoints; leave them empty unless a sandbox is used. Keep the client secret out of Git.
# SATUSEHAT_AUTH_URL=
# SATUSEHAT_BASE_URL=
# SATUSEHAT_ORG_ID=
# SATUSEHAT_CLIENT_ID=
# SATUSEHAT_CLIENT_SECRET=

# SIMRS aggregate import (src/melinda_maaf/simrs_aggregate.py --pull). The token is optional.
# MELINDAOS_SIMRS_EXPORT_URL=
# MELINDAOS_SIMRS_EXPORT_TOKEN=
