{
  "schemaVersion": 1,
  "id": "healthcare/melindaos",
  "repository": "git@github.com:gaffercode/MelindaOs.git",
  "owner": "Gaffer (dr. Ferdi Andriska)",
  "risk": "R2",
  "runtime": {
    "name": "node",
    "version": "24"
  },
  "packageManager": {
    "name": "npm",
    "version": "11.19.0",
    "lockfile": "dashboard/package-lock.json"
  },
  "commands": {
    "install": { "program": "node", "args": ["tools/capsule.mjs", "install"], "timeoutSeconds": 600 },
    "lint": { "program": "node", "args": ["tools/capsule.mjs", "lint"], "timeoutSeconds": 600 },
    "typecheck": { "program": "node", "args": ["tools/capsule.mjs", "typecheck"], "timeoutSeconds": 600 },
    "test": { "program": "node", "args": ["tools/capsule.mjs", "test"], "timeoutSeconds": 600 },
    "build": { "program": "node", "args": ["tools/capsule.mjs", "build"], "timeoutSeconds": 600 },
    "run": { "program": "node", "args": ["tools/capsule.mjs", "run"] },
    "deployDryRun": { "program": "node", "args": ["tools/capsule.mjs", "deploy-dry-run"], "timeoutSeconds": 600 }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 4347,
    "path": "/api/health",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 120
  },
  "artifacts": ["dashboard/.next/BUILD_ID"],
  "externalDependencies": [
    { "kind": "registry", "name": "npm registry", "locator": "https://registry.npmjs.org", "required": true },
    { "kind": "registry", "name": "PyPI through uv, locked by uv.lock (uv also fetches Python 3.12 when none is installed)", "locator": "https://pypi.org/simple", "required": true },
    { "kind": "tool", "name": "uv, the Python project manager on PATH", "locator": "uv", "required": true },
    { "kind": "database", "name": "Supabase (director store, Studio, answers, unit reports)", "locator": "MELINDAOS_SUPABASE_URL", "required": false },
    { "kind": "service", "name": "Supabase server key", "locator": "MELINDAOS_SUPABASE_SECRET_KEY", "required": false },
    { "kind": "service", "name": "Director store mode", "locator": "MELINDAOS_DIRECTOR_STORE", "required": false },
    { "kind": "service", "name": "Allowed app origin for director login", "locator": "MELINDAOS_APP_ORIGIN", "required": false },
    { "kind": "service", "name": "Reviewer sign-in", "locator": "MELINDAOS_REVIEWER_PASSCODE_HASH", "required": false },
    { "kind": "service", "name": "Claude model provider for Melinda and Tanya Melinda", "locator": "MELINDAOS_CLAUDE_API_KEY", "required": false },
    { "kind": "service", "name": "Medify publisher token hash", "locator": "MELINDAOS_MEDIFY_PUBLISHER_TOKEN_HASH", "required": false },
    { "kind": "service", "name": "Reception WhatsApp for the public referral sheet", "locator": "MELINDAOS_REFERRAL_WHATSAPP", "required": false },
    { "kind": "service", "name": "Google Drive service account for STARKES evidence", "locator": "MELINDAOS_GOOGLE_SA_JSON", "required": false },
    { "kind": "service", "name": "Buffer social publishing", "locator": "BUFFER_API_KEY", "required": false },
    { "kind": "database", "name": "Synthetic Supabase for opt-in integration tests", "locator": "MELINDAOS_TEST_SUPABASE_URL", "required": false }
  ],
  "mutableStatePaths": [
    ".venv",
    "tests/.pytest_cache",
    "dashboard/node_modules",
    "dashboard/.next",
    "dashboard/.vitest",
    "dashboard/coverage",
    "dashboard/tsconfig.tsbuildinfo",
    "dashboard/next-env.d.ts",
    "dashboard/data/agent-file-contents.json",
    "dashboard/data/agent-files.json",
    "dashboard/data/director-queue.json",
    "dashboard/data/knowledge-chunks.json",
    "dashboard/data/knowledge-index.json",
    "dashboard/data/knowledge-search-index.json",
    "dashboard/data/studio-source-snapshot.json",
    "dashboard/data/chatgpt",
    "dashboard/data/director/2026-10-24.json",
    "dashboard/data/melinda/2026-10-26.json",
    "dashboard/data/simrs/2026-10-24.json",
    "dashboard/.env.local",
    "dashboard/.impeccable",
    "dashboard/build.log",
    "dashboard/assets/fonts/Calibri-Bold.ttf",
    "dashboard/assets/fonts/Calibri-Italic.ttf",
    "dashboard/assets/fonts/Calibri-Regular.ttf",
    "dashboard/public/branding/preview-spo-ppi1-official.pdf",
    "dashboard/public/kredensial/01_PERSYARATAN_MUTLAK",
    "dashboard/public/kredensial/02_KOMITMEN_KINERJA_DAN_MUTU",
    "dashboard/public/kredensial/03_SARANA_TT_DAN_KRIS",
    "dashboard/public/kredensial/04_SDM_DAN_KREDENSIAL",
    "dashboard/public/kredensial/05_SARPRAS_FASILITAS_DAN_KALIBRASI",
    "dashboard/public/kredensial/06_SISTEM_INFORMASI_DAN_MUTU",
    "dashboard/public/kredensial/07_PROSEDUR_DAN_ADMINISTRASI",
    "dashboard/public/kredensial/08_CLINICAL_PATHWAY_DAN_PPK",
    "knowledge/07_LEGAL_REGULATORY/kredensial/berkas_2026/bukti_foto",
    "sources",
    "app",
    ".claude/settings.local.json",
    ".claude/worktrees",
    ".claude/agent-memory",
    ".cursor",
    "build.log"
  ]
}
